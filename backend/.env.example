DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=AdventureWorks2025
DB_USER=usuario_de_aplicacion
DB_PASSWORD=aqui_va_la_contrasena
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

PORT=3000
NODE_ENV=development

JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------
# Despliegue en Azure App Service
# ---------------------------------------------------------------------
# Estos valores NO se escriben en un archivo .env: se cargan en el portal
# de Azure, en Configuration > Application settings, que App Service
# expone como variables de entorno reales. dotenv nunca sobrescribe una
# variable que ya existe en el entorno, asi que el mismo codigo funciona
# en local (leyendo .env) y en Azure (leyendo la configuracion del
# servicio), sin cambios.
#
# NODE_ENV=production
# PORT=8080
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
#
# DB_SERVER, DB_DATABASE, DB_USER, DB_PASSWORD y JWT_SECRET tambien se
# cargan ahi, con los valores de la instancia de Azure SQL Database.
